# Unprofitable Mahjong for the M5Stack Tab5.
#
# The board lines are the player's (defeatist-music-player-for-m5tab5's
# sdkconfig.defaults), which have run on Tab5s; see that file for why
# each one is there. Changing this file needs `rm sdkconfig` before the
# next build: the defaults only fill keys an existing sdkconfig lacks.

CONFIG_IDF_TARGET="esp32p4"
# The Tab5s this has run on are silicon v1.3.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# Code runs from PSRAM, so a flash write or erase (every save) no longer
# pauses it: without this, a save flashed the panel cyan.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
# The game loop runs on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# feckless_drivers builds its USB host even though nothing here plugs
# into it; these are the player's settings for that host, per the
# drivers README.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
CONFIG_USB_HOST_ENABLE_ENUM_FILTER_CALLBACK=y
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

# feckless_camera (components/feckless_camera/README.md): the Tab5's
# sensor, and the ISP controller that gives it auto exposure -- without
# it the picture is near black. Espressif's m5stack_tab5 BSP sets both.
CONFIG_CAMERA_SC202CS=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# The sensor's tuning is esp_cam_sensor's sc202cs_default.json with its
# colour matrices made the identity (camera/README.md): under warm light
# the default's came out past the ISP's limit of 4.0, and every frame's
# was refused with five error lines. Only the grey is used. The
# algorithms themselves stay: the sensor's pipeline will not start
# without AWB and ACC, so they are said outright here.
CONFIG_ESP_IPA_AWB_ALGORITHM=y
CONFIG_ESP_IPA_ACC_ALGORITHM=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_SC202CS_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="camera/sc202cs_ipa.json"
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# The game is an ELF the firmware loads (elf/, and feckless_abi's
# checks, which fail the build without these). esp_elf puts it in PSRAM,
# which the P4 can execute from; internal SRAM is not executable while
# PMP splits it from IRAM. Memory protection off, as elf_loader's PSRAM
# examples have it. Lothesome's sdkconfig.defaults sets the same.
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ESP_SYSTEM_MEMPROT_FEATURE=n
# feckless_abi warns without it, on the build that runs the ELF: it is
# compiled into the USB audio driver the drivers link, though nothing
# here uses USB audio. Lothesome's sdkconfig.defaults says why.
CONFIG_UAC_FREQ_NUM_MAX=8
